generator client {
  provider = "prisma-client-js"
  output   = "../src/infrastructure/prisma/prisma-client"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum DayOfWeek {
  SUNDAY
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
}

enum AuditAction {
  MODIFICATION
  ADDITION
  DELETION
}

enum AuditSubject {
  COMPANY_NAME
  COMPANY_NON_WORKING_WEEKDAY
  COMPANY_PUBLIC_HOLIDAY
}

enum AuditSide {
  BEFORE
  AFTER
}

model Company {
  id                   String                   @id @default(uuid())
  name                 String
  nonWorkingWeekdays   CompanyNonWorkingWeekday[]
  publicHolidays       CompanyPublicHoliday[]
  auditEvents          AuditEvent[]
  employees            Employee[]
  expenseCategories    ExpenseCategory[]
  expenseReports       ExpenseReport[]
  notifications        Notification[]
}

model CompanyNonWorkingWeekday {
  companyId String
  dayOfWeek DayOfWeek
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@id([companyId, dayOfWeek])
}

model PublicHoliday {
  id        String                 @id @default(uuid())
  date      String
  label     String
  companies CompanyPublicHoliday[]

  @@unique([date, label])
}

model CompanyPublicHoliday {
  companyId       String
  publicHolidayId String
  company         Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  publicHoliday   PublicHoliday @relation(fields: [publicHolidayId], references: [id], onDelete: Restrict)

  @@id([companyId, publicHolidayId])
}

model AuditEvent {
  id         String          @id @default(uuid())
  companyId  String
  actorId    String
  occurredAt DateTime
  action     AuditAction
  subject    AuditSubject
  company    Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  snapshots  AuditSnapshot[]
}

model AuditSnapshot {
  id              String                 @id @default(uuid())
  eventId         String
  side            AuditSide
  companyName     String?
  publicHolidayId String?
  holidayDate     String?
  holidayLabel    String?
  event           AuditEvent             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  daysOfWeek      AuditSnapshotDayOfWeek[]

  @@unique([eventId, side])
}

model AuditSnapshotDayOfWeek {
  snapshotId String
  dayOfWeek  DayOfWeek
  snapshot   AuditSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  @@id([snapshotId, dayOfWeek])
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
}

enum ExpenseReportStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  VALIDATED
  REFUSED
  REIMBURSED
}

model Employee {
  id             String          @id
  companyId      String
  status         EmployeeStatus
  company        Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  expenseReports ExpenseReport[]
}

model ExpenseCategory {
  id        String  @id @default(uuid())
  companyId String
  label     String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, label])
}

model ExpenseReport {
  id         String        @id @default(uuid())
  companyId  String
  employeeId String
  label      String
  status     ExpenseReportStatus @default(DRAFT)
  createdAt  DateTime      @default(now())
  company    Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee   Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  expenses   Expense[]
  receipts   Receipt[]
}

model Expense {
  id            String        @id @default(uuid())
  reportId      String
  date          String
  categoryId    String
  amountCents   Int
  vatCents      Int?
  paymentMethod String
  description   String
  assignment    String
  createdAt     DateTime      @default(now())
  report        ExpenseReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  receipts      Receipt[]
}

model Receipt {
  id        String        @id @default(uuid())
  reportId  String
  expenseId String?
  fileName  String
  mimeType  String
  content   Bytes
  createdAt DateTime      @default(now())
  report    ExpenseReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  expense   Expense?      @relation(fields: [expenseId], references: [id], onDelete: SetNull)
}

model Notification {
  id                 String   @id @default(uuid())
  companyId          String
  type               String
  recipientUserId    String?
  recipientEmployers Boolean  @default(false)
  targetKind         String
  targetId           String
  createdAt          DateTime
  read               Boolean  @default(false)
  company            Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
}
