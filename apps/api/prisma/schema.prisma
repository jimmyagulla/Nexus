generator client {
  provider = "prisma-client-js"
  output   = "../src/infrastructure/prisma/prisma-client"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum DayOfWeek {
  SUNDAY
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
}

enum AuditAction {
  MODIFICATION
  ADDITION
  DELETION
}

enum AuditSubject {
  COMPANY_NAME
  COMPANY_NON_WORKING_WEEKDAY
  COMPANY_PUBLIC_HOLIDAY
}

enum AuditSide {
  BEFORE
  AFTER
}

// Declaration order is the descending sort order of the documents list
// (alphabetical order of the French labels); keep it in step with the domain.
enum DocumentCategory {
  SICK_LEAVE
  OTHER
  ADMINISTRATIVE
  PROOF
}

enum DocumentStatus {
  SEEN
  PENDING
  NEW
  PROCESSED
}

enum DocumentFileFormat {
  PDF
  JPEG
  PNG
  XLS
  XLSX
  CSV
}

model Company {
  id                 String                     @id @default(uuid())
  name               String
  nonWorkingWeekdays CompanyNonWorkingWeekday[]
  publicHolidays     CompanyPublicHoliday[]
  auditEvents        AuditEvent[]
  documents          Document[]
}

model CompanyNonWorkingWeekday {
  companyId String
  dayOfWeek DayOfWeek
  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@id([companyId, dayOfWeek])
}

model PublicHoliday {
  id        String                 @id @default(uuid())
  date      String
  label     String
  companies CompanyPublicHoliday[]

  @@unique([date, label])
}

model CompanyPublicHoliday {
  companyId       String
  publicHolidayId String
  company         Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  publicHoliday   PublicHoliday @relation(fields: [publicHolidayId], references: [id], onDelete: Restrict)

  @@id([companyId, publicHolidayId])
}

model AuditEvent {
  id         String          @id @default(uuid())
  companyId  String
  actorId    String
  occurredAt DateTime
  action     AuditAction
  subject    AuditSubject
  company    Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  snapshots  AuditSnapshot[]
}

model AuditSnapshot {
  id              String                   @id @default(uuid())
  eventId         String
  side            AuditSide
  companyName     String?
  publicHolidayId String?
  holidayDate     String?
  holidayLabel    String?
  event           AuditEvent               @relation(fields: [eventId], references: [id], onDelete: Cascade)
  daysOfWeek      AuditSnapshotDayOfWeek[]

  @@unique([eventId, side])
}

model AuditSnapshotDayOfWeek {
  snapshotId String
  dayOfWeek  DayOfWeek
  snapshot   AuditSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  @@id([snapshotId, dayOfWeek])
}

// Metadata of a deposited document; the file itself lives in the private
// `documents` storage bucket under `storageKey`. Size and length limits are
// also enforced by CHECK constraints: see prisma/sql/documents.sql.
model Document {
  id           String             @id @default(uuid())
  companyId    String
  ownerId      String             @db.VarChar(64)
  uploadedById String             @db.VarChar(64)
  name         String             @db.VarChar(50)
  category     DocumentCategory
  status       DocumentStatus
  format       DocumentFileFormat
  sizeBytes    Int
  comment      String?            @db.VarChar(250)
  storageKey   String             @unique @db.VarChar(255)
  createdAt    DateTime           @default(now()) @db.Timestamptz(3)
  company      Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, ownerId, createdAt(sort: Desc)])
}
