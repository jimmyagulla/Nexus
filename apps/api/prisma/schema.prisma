generator client {
  provider = "prisma-client-js"
  output   = "../src/infrastructure/prisma/prisma-client"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum DayOfWeek {
  SUNDAY
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
}

enum AuditAction {
  MODIFICATION
  ADDITION
  DELETION
}

enum AuditSubject {
  COMPANY_NAME
  COMPANY_NON_WORKING_WEEKDAY
  COMPANY_PUBLIC_HOLIDAY
}

enum AuditSide {
  BEFORE
  AFTER
}

// Declaration order is the descending sort order of the documents list
// (alphabetical order of the French labels); keep it in step with the domain.
enum DocumentCategory {
  SICK_LEAVE
  OTHER
  ADMINISTRATIVE
  PROOF
}

enum DocumentStatus {
  SEEN
  PENDING
  NEW
  PROCESSED
}

enum DocumentFileFormat {
  PDF
  JPEG
  PNG
  XLS
  XLSX
  CSV
}

enum EmploymentContractType {
  PERMANENT
  FIXED_TERM
  APPRENTICESHIP
  PROFESSIONALISATION
  INTERNSHIP
}

enum WorkingTime {
  FULL_TIME
  PART_TIME
}

model Company {
  id                 String                     @id @default(uuid())
  name               String
  nonWorkingWeekdays CompanyNonWorkingWeekday[]
  publicHolidays     CompanyPublicHoliday[]
  auditEvents        AuditEvent[]
  documents          Document[]
  payslips           Payslip[]
  personalInfos      PersonalInfo[]
}

model CompanyNonWorkingWeekday {
  companyId String
  dayOfWeek DayOfWeek
  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@id([companyId, dayOfWeek])
}

model PublicHoliday {
  id        String                 @id @default(uuid())
  date      String
  label     String
  companies CompanyPublicHoliday[]

  @@unique([date, label])
}

model CompanyPublicHoliday {
  companyId       String
  publicHolidayId String
  company         Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  publicHoliday   PublicHoliday @relation(fields: [publicHolidayId], references: [id], onDelete: Restrict)

  @@id([companyId, publicHolidayId])
}

model AuditEvent {
  id         String          @id @default(uuid())
  companyId  String
  actorId    String
  occurredAt DateTime
  action     AuditAction
  subject    AuditSubject
  company    Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  snapshots  AuditSnapshot[]
}

model AuditSnapshot {
  id              String                   @id @default(uuid())
  eventId         String
  side            AuditSide
  companyName     String?
  publicHolidayId String?
  holidayDate     String?
  holidayLabel    String?
  event           AuditEvent               @relation(fields: [eventId], references: [id], onDelete: Cascade)
  daysOfWeek      AuditSnapshotDayOfWeek[]

  @@unique([eventId, side])
}

model AuditSnapshotDayOfWeek {
  snapshotId String
  dayOfWeek  DayOfWeek
  snapshot   AuditSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  @@id([snapshotId, dayOfWeek])
}

// Metadata of a deposited document; the file itself lives in the private
// `documents` storage bucket under `storageKey`. Size and length limits are
// also enforced by CHECK constraints: see prisma/sql/documents.sql.
model Document {
  id           String             @id @default(uuid())
  companyId    String
  ownerId      String             @db.VarChar(64)
  uploadedById String             @db.VarChar(64)
  name         String             @db.VarChar(50)
  category     DocumentCategory
  status       DocumentStatus
  format       DocumentFileFormat
  sizeBytes    Int
  comment      String?            @db.VarChar(250)
  storageKey   String             @unique @db.VarChar(255)
  createdAt    DateTime           @default(now()) @db.Timestamptz(3)
  company      Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, ownerId, createdAt(sort: Desc)])
}

// Metadata of a payslip made available by the employer; the file itself lives
// in the private `payslips` storage bucket under `storageKey`. Ranges and
// length limits are also enforced by CHECK constraints: see prisma/sql/payslips.sql.
model Payslip {
  id           String             @id @default(uuid())
  companyId    String
  employeeId   String             @db.VarChar(64)
  uploadedById String             @db.VarChar(64)
  employerName String             @db.VarChar(100)
  year         Int                @db.SmallInt
  month        Int                @db.SmallInt
  fileName     String             @db.VarChar(50)
  format       DocumentFileFormat
  sizeBytes    Int
  storageKey   String             @unique @db.VarChar(255)
  availableAt  DateTime           @db.Timestamptz(3)
  createdAt    DateTime           @default(now()) @db.Timestamptz(3)
  company      Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, employeeId, year, month])
}

// Personal information of an employee in a company: the contact details the
// employee keeps up to date, and what the employer records. Formats and
// length limits are also enforced by CHECK constraints: see
// prisma/sql/personal-info.sql.
model PersonalInfo {
  companyId            String
  employeeId           String                 @db.VarChar(64)
  address              String                 @db.VarChar(150)
  postalCodeAndCity    String                 @db.VarChar(100)
  phone                String                 @db.VarChar(20)
  email                String                 @db.VarChar(254)
  lastName             String                 @db.VarChar(100)
  firstName            String                 @db.VarChar(100)
  birthDate            DateTime               @db.Date
  socialSecurityNumber String                 @db.VarChar(15)
  jobTitle             String                 @db.VarChar(100)
  department           String                 @db.VarChar(100)
  contractType         EmploymentContractType
  workingTime          WorkingTime
  startDate            DateTime               @db.Date
  iban                 String                 @db.VarChar(34)
  updatedAt            DateTime               @db.Timestamptz(3)
  company              Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@id([companyId, employeeId])
}
