{
  "name": "@hexagonal-monorepo-template/source",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "start": "nx run-many -t serve --projects=api,dashboard",
    "invoke:lambda": "nx run api:invoke-lambda",
    "build": "nx run-many -t build",
    "all": "pnpm run test && pnpm run test:e2e",
    "health-check": "pnpm install && pnpm audit && pnpm run all && pnpm run lint && pnpm run build && pnpm run invoke:lambda",
    "test": "nx run-many -t test",
    "test:e2e": "nx e2e api-e2e",
    "lint": "nx run-many -t lint",
    "graph": "nx graph",
    "postinstall": "pnpm prisma:generate",
    "prisma:generate": "prisma generate --schema apps/api/prisma/schema.prisma",
    "prisma:push": "prisma db push --schema apps/api/prisma/schema.prisma",
    "prisma:pull": "prisma db pull --schema apps/api/prisma/schema.prisma"
  },
