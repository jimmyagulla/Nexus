# Monorepo root: copy to `.env`, restart `pnpm start` after edits; API reads via loadWorkspaceEnv, dashboard only VITE_*, Prisma uses DATABASE_URL/DIRECT_URL, E2E uses HOST.

# --- Quick start (local, no Supabase): AUTH_DISABLED=true, VITE_AUTH_DISABLED=true, PERSISTENCE=memory, PORT=3000, VITE_API_URL=http://localhost:3000/api ---

# --- API HTTP (Nest) ---
# PORT: listen port, default 3000 — apps/api, Swagger, dashboard proxy target
PORT=3000
# API_GLOBAL_PREFIX: Nest prefix, default api — apps/api; whitespace-only fails startup
API_GLOBAL_PREFIX=api
# PERSISTENCE: memory | postgres, default memory — apps/api repositories
PERSISTENCE=memory
# AUTH_DISABLED: true skips JWT and uses in-memory employer — apps/api; pair with VITE_AUTH_DISABLED=true locally
AUTH_DISABLED=

# --- API Postgres (when PERSISTENCE=postgres) ---
# DATABASE_URL: Supabase → Settings → Database → Connection string (URI) — Prisma + apps/api
DATABASE_URL=
# DIRECT_URL: Supabase → Database → Direct connection URI — Prisma migrations / db push
DIRECT_URL=

# --- API Supabase auth (when AUTH_DISABLED is not true) ---
# SUPABASE_URL: Supabase → Settings → API → Project URL (https, not postgres URI) — server-side
SUPABASE_URL=
# SUPABASE_JWKS_URL: {SUPABASE_URL}/auth/v1/.well-known/jwks.json — apps/api JWT verify; empty rejects JWTs unless AUTH_DISABLED
SUPABASE_JWKS_URL=
# SUPABASE_SERVICE_ROLE_KEY: Supabase → API → service_role (secret, never VITE_*) — server admin
SUPABASE_SERVICE_ROLE_KEY=

# --- Dashboard Vite (browser) ---
# VITE_API_URL: Nest base URL with prefix, default http://localhost:3000/api — must match PORT + API_GLOBAL_PREFIX; /api proxied in dev
VITE_API_URL=http://localhost:3000/api
# VITE_AUTH_DISABLED: true uses in-memory employer in browser — apps/dashboard; pair with AUTH_DISABLED=true locally
VITE_AUTH_DISABLED=
# VITE_SUPABASE_URL: Supabase → Settings → API → Project URL — required if VITE_AUTH_DISABLED is not true
VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY: Supabase → Settings → API → anon public — required if VITE_AUTH_DISABLED is not true
VITE_SUPABASE_ANON_KEY=

# --- Tooling (optional) ---
# NODE_ENV: development | production | test — apps/api webpack.config.js
NODE_ENV=development
# HOST: api-e2e HTTP host, default localhost — not the Vite bind address
HOST=
