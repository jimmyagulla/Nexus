HOST=
PORT=3000
NODE_ENV=development
API_GLOBAL_PREFIX=api
PERSISTENCE=memory
# true skips JWT checks and uses the local in-memory employer
AUTH_DISABLED=
DATABASE_URL=
DIRECT_URL=
SUPABASE_URL=
SUPABASE_JWKS_URL=
SUPABASE_SERVICE_ROLE_KEY=
VITE_API_URL=http://localhost:3000/api
# true skips the browser Supabase session and uses the local in-memory employer
VITE_AUTH_DISABLED=
# HTTPS project URL (Settings → API), NOT the Postgres DATABASE_URL
VITE_SUPABASE_URL=
# anon public key (Settings → API)
VITE_SUPABASE_ANON_KEY=
